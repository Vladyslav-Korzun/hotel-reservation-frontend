{
  "name": "academy-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api-types": "openapi-typescript ../Academy_Backend-main/application/api-spec/src/main/resources/openapi/hotel-reservation.yaml -o src/app/core/api/generated/hotel-reservation.types.ts",
    "check:api-types": "node scripts/check-api-types.cjs",
    "start": "ng serve --proxy-config=proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "angular-oauth2-oidc": "^20.0.2",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
